# PowerShell example:
# $env:YOLO_MODEL_PATH="D:\專題\train6\weights\best.pt"
# $env:LLM_MODEL="TwinkleAI/gemma-3-4B-T1-it"
YOLO_MODEL_PATH=train6/weights/best.pt
LLM_MODEL=TwinkleAI/gemma-3-4B-T1-it
MAP_KMEANS_K=6
MAP_YOLO_CONF=0.15
MAP_YOLO_IMGSZ=896
MAP_DOOR_RATIO=0.01
MAP_MAX_ASTAR_CALLS=140
ROOM_IDLE_TIMEOUT=1800

# Path selection: shortest distance remains the hard limit; reduce turns only inside it.
NAV_TURN_PENALTY_PX=80
NAV_U_TURN_PENALTY_PX=240
NAV_MAX_DETOUR_RATIO=1.03
NAV_MAX_DETOUR_SLACK_PX=5
NAV_STRAIGHT_TOLERANCE_DEG=25
NAV_DIRECTION_BIN_DEG=15
