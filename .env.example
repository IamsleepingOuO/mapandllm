# Grounding DINO
DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
DINO_DEVICE=cuda
DINO_SHORT_EDGE=640
DINO_LONG_EDGE=1067
DINO_LABELS=store sign|storefront sign|shop name sign|brand sign above shop entrance|wall mounted store sign
DINO_BOX_THRESHOLD=0.25
DINO_TEXT_THRESHOLD=0.22
MAX_DETECTIONS=3
MIN_BOX_AREA_RATIO=0.002
CROP_PADDING_RATIO=0.08

# PaddleOCR
# 建議先用 CPU，避免和 PyTorch GPU wheel 的 CUDA/cuDNN/NCCL Python 依賴互相覆蓋。
OCR_DEVICE=cpu
OCR_DET_MODEL=PP-OCRv5_server_det
OCR_REC_MODEL=PP-OCRv5_server_rec
OCR_LANG=chinese_cht
OCR_VERSION=PP-OCRv5
OCR_SCORE_THRESHOLD=0.45
# 先關閉 oneDNN，可避開你先前遇到的 Paddle 3.x PIR oneDNN 錯誤。
OCR_ENABLE_MKLDNN=0

# Save captured frames / recognition results on the workstation
# Relative paths are resolved from the project root.
SAVE_ROOT=saved
SAVE_ANNOTATED=1
# Set to 1 only when you also want every detected sign crop saved.
SAVE_CROPS=0
# Optional CJK font for labels in annotated JPEGs, e.g.
# ANNOTATION_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Map navigation and LLM
YOLO_MODEL_PATH=train6/weights/best.pt
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=gemma4

# Topology navigation: distance is the hard limit; turns are reduced only within it.
NAV_TURN_PENALTY_PX=80
NAV_U_TURN_PENALTY_PX=240
NAV_MAX_DETOUR_RATIO=1.03
NAV_MAX_DETOUR_SLACK_PX=5
NAV_STRAIGHT_TOLERANCE_DEG=25
NAV_DIRECTION_BIN_DEG=15
MAP_WORKER_TIMEOUT=7200
ROOM_IDLE_TIMEOUT=1800
LLM_NUM_CTX=4096
